# 012 MEDIA — environment configuration (copy to .env; never commit real values)

# --- Storage -------------------------------------------------------------
DATA_DIR=var                      # SQLite DB, research store, rendered editions, sandbox outbox

# --- 012 Intelligence Engine ---------------------------------------------
# anthropic = Claude API (requires ANTHROPIC_API_KEY); handoff = recorded operator-session analysis
ENGINE_PROVIDER=anthropic
ANTHROPIC_API_KEY=                # secret; set in the deployment environment
ENGINE_MODEL=claude-opus-5-5
MAX_LLM_CALLS_PER_RUN=80          # cost cap per research run

# --- 012 Publishing Engine -----------------------------------------------
MAILER=outbox                     # outbox (sandbox, writes files) | resend
RESEND_API_KEY=                   # secret; required when MAILER=resend
MAIL_FROM="012 MEDIA <brief@zeroonetwo.media>"   # verified sending domain (SPF/DKIM/DMARC)
MAIL_REPLY_TO=
PUBLISHER_IDENTITY="012 MEDIA · <legal entity, postal address>"   # CASL sender identification — REQUIRED
SITE_URL=https://zeroonetwo.media
EDITION_BASE_URL=https://zeroonetwo.media/e      # where unlisted HTML/PDF editions are served
UNSUBSCRIBE_SECRET=               # secret, ≥ 16 chars; signs one-click unsubscribe tokens
UNLISTED_URL_SECRET=              # secret; derives unguessable edition URLs
TEST_RECIPIENTS_ONLY=true         # dry runs: deliver only to subscribers flagged is_test
