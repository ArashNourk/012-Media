# 012.media — environment configuration (copy to .env for local runs; set these in the host for production).
# Never commit real values.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development              # production enables HSTS, strict origin checks and required-secret checks
PORT=3000
DATA_DIR=var                      # SQLite DB, research store, rendered editions, sandbox outbox
SITE_URL=https://012.media        # use http://localhost:3000 locally
EDITION_BASE_URL=https://012.media/e
TRUST_PROXY=false                 # true behind Render/another proxy (uses X-Forwarded-For / -Proto)

# --- Secrets (required in production; generated per process in development) ---
FORM_SECRET=                      # signs access-form tokens
UNSUBSCRIBE_SECRET=               # ≥ 16 chars; signs one-click unsubscribe links
UNLISTED_URL_SECRET=              # derives unguessable edition URLs

# --- Publisher identity (CASL) -------------------------------------------
PUBLISHER_IDENTITY="012 MEDIA · <legal entity>, <postal address>"   # required in production
CONTACT_EMAIL=                    # shown on /about and /privacy

# --- Email ----------------------------------------------------------------
MAILER=outbox                     # outbox (sandbox: writes files under DATA_DIR/outbox) | resend
RESEND_API_KEY=                   # required when MAILER=resend
MAIL_FROM="012 MEDIA <brief@012.media>"   # domain must be verified in Resend (SPF/DKIM/DMARC)
MAIL_REPLY_TO=
TEST_RECIPIENTS_ONLY=true         # editions go only to subscribers flagged is_test until launch

# --- Scheduler and 012 Intelligence Engine --------------------------------
ENABLE_SCHEDULER=false            # true: in-process 9:00 Toronto send loop (one instance only)
SCHEDULER_INTERVAL_SECONDS=300
ENABLE_RESEARCH=false             # true: prepare each weekday's draft automatically after RESEARCH_AT
RESEARCH_AT=05:30                 # America/Toronto
ENGINE_PROVIDER=anthropic         # anthropic | handoff
ANTHROPIC_API_KEY=
ENGINE_MODEL=claude-opus-5-5
MAX_LLM_CALLS_PER_RUN=80
